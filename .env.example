# ── App ─────────────────────────────────────────────────────────────────────────
PORT=8080
BASE_URL=https://chat.blueprintautomation.tech
ENV=development
LOG_LEVEL=info

# ── Admin Auth ───────────────────────────────────────────────────────────────────
# Long random string: openssl rand -hex 32
BLUEPRINT_ADMIN_KEY=

# ── Database ─────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://blueprint:changeme@localhost:5432/blueprint_chat?sslmode=disable
POSTGRES_USER=blueprint
POSTGRES_PASSWORD=changeme

# ── Redis ────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_SESSION_TTL_MINUTES=30
REDIS_CONFIG_CACHE_TTL_MINUTES=5

# ── Anthropic ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=1024

# ── Encryption ───────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Scheduler ────────────────────────────────────────────────────────────────────
DEFAULT_SCHEDULER=calcom
CALCOM_API_BASE=https://api.cal.com/v1
CALENDLY_API_BASE=https://api.calendly.com

# ── Email Notifications ──────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_FROM_EMAIL=chat@blueprintautomation.tech
NOTIFICATION_FROM_NAME=Blueprint Chat

# ── Discord ──────────────────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=

# ── n8n ──────────────────────────────────────────────────────────────────────────
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
N8N_USER=admin
N8N_PASSWORD=changeme

# ── Rate Limits ──────────────────────────────────────────────────────────────────
RATE_LIMIT_MESSAGES_PER_MIN=30
RATE_LIMIT_MESSAGES_PER_DAY=1000

# ── Widget ───────────────────────────────────────────────────────────────────────
WIDGET_BUNDLE_PATH=./widget/dist/widget.js
WIDGET_MAX_SIZE_KB=50

# ── Blueprint Command Integration ────────────────────────────────────────────────
# Partner keys use format: bpa_partner_{partnerUUID}_{random}
# UUID is parsed directly from key — no external API call needed.
# Super admin keys use prefix: bpa_super_
BLUEPRINT_COMMAND_API_URL=http://blueprint-command-api:8094
